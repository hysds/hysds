{% set code_dir = (OPS_HOME ~ '/mozart') if SINGLE_MACHINE_CLUSTER else (OPS_HOME ~ '/sciflo') -%}
{% if not SINGLE_MACHINE_CLUSTER -%}
[unix_http_server]
file=%(here)s/../run/supervisor.sock

[inet_http_server]
port = 0.0.0.0:9001
username = ops
password = ops

[supervisord]
pidfile=%(here)s/../run/supervisord.pid
logfile=%(here)s/../log/supervisord.log
logfile_maxbytes=50MB
logfile_backups=10
loglevel=info
nodaemon=false
minfds=1024
minprocs=200

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://%(here)s/../run/supervisor.sock

{% endif -%}
[program:grq2]
directory={{ code_dir }}/ops/grq2
command=gunicorn -w4 -b 0.0.0.0:8878 -k gevent --log-level=debug
        --keyfile={{ LOCALHOST_KEYFILE }}
        --certfile={{ LOCALHOST_CRT }}
        --limit-request-line=0 grq2:app
process_name=%(program_name)s
priority=1
numprocs=1
numprocs_start=0
redirect_stderr=true
stdout_logfile=%(here)s/../log/%(program_name)s.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
startsecs=10

[program:grq_instance_stats]
directory={{ code_dir }}/ops/hysds/scripts
command={{ code_dir }}/ops/hysds/scripts/log_instance_stats.py --interval 600
process_name=%(program_name)s
priority=1
numprocs=1
numprocs_start=0
redirect_stderr=true
stdout_logfile=%(here)s/../log/%(program_name)s.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
startsecs=10

[program:pele]
directory={{ code_dir }}/ops/pele
command=gunicorn -w4 -b 127.0.0.1:8877 -k gevent --timeout=3600
        --keyfile={{ LOCALHOST_KEYFILE }}
        --certfile={{ LOCALHOST_CRT }}
        --graceful-timeout=3600 --log-level=debug
        --limit-request-line=0
        'pele:create_app("pele.settings.ProductionConfig")'
process_name=%(program_name)s
priority=1
numprocs=1
numprocs_start=0
redirect_stderr=true
stdout_logfile=%(here)s/../log/%(program_name)s.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
startsecs=10
